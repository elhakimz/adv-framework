<!--
  ADV pipeline support — plugin declarations + profiles
  Merge this into your existing pom.xml:
    - <properties> keys go into your existing <properties> block
    - <dependencies> go into your existing <dependencies> block
    - <build><plugins> go into your existing <build><plugins> block
    - <profiles> can be added as a top-level sibling of <build>
-->

<properties>
    <maven.compiler.release>21</maven.compiler.release>
    <junit.jupiter.version>5.11.0</junit.jupiter.version>
    <jqwik.version>1.9.1</jqwik.version>
    <jacoco.version>0.8.12</jacoco.version>
    <checkstyle.version>3.5.0</checkstyle.version>
    <checkstyle.rules.version>10.18.1</checkstyle.rules.version>
    <pmd.version>3.25.0</pmd.version>
    <!-- Autofix tier (local only — see references/local-verification.md).
         Pin exact versions: an unpinned formatter reformats the whole
         codebase on upgrade and breaks reproducibility of spotless:check. -->
    <spotless.version>3.10.2</spotless.version>
    <google-java-format.version>1.30.0</google-java-format.version>
    <rewrite-maven-plugin.version>6.29.0</rewrite-maven-plugin.version>
    <rewrite-static-analysis.version>2.40.0</rewrite-static-analysis.version>
</properties>

<dependencies>
    <!-- Regular unit testing -->
    <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.jupiter.version}</version>
        <scope>test</scope>
    </dependency>

    <!-- Property/invariant testing — generates adversarial inputs -->
    <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
    </dependency>
</dependencies>

<build>
    <plugins>
        <!-- ================= STATIC LAYER ================= -->

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <version>${checkstyle.version}</version>
            <dependencies>
                <dependency>
                    <groupId>com.puppycrawl.tools</groupId>
                    <artifactId>checkstyle</artifactId>
                    <version>${checkstyle.rules.version}</version>
                </dependency>
            </dependencies>
            <configuration>
                <!-- Start from Google's ruleset and tune from there rather than
                     writing one from scratch — swap for a custom XML once you
                     know which rules you actually want to enforce vs relax -->
                <configLocation>google_checks.xml</configLocation>
                <consoleOutput>true</consoleOutput>
                <failsOnError>true</failsOnError>
                <violationSeverity>warning</violationSeverity>
            </configuration>
        </plugin>

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <version>${pmd.version}</version>
            <configuration>
                <rulesets>
                    <ruleset>category/java/bestpractices.xml</ruleset>
                    <ruleset>category/java/errorprone.xml</ruleset>
                    <ruleset>category/java/design.xml</ruleset>
                </rulesets>
                <printFailingErrors>true</printFailingErrors>
            </configuration>
        </plugin>

        <!-- Formatting gate. CI and pre-push run `mvn spotless:check` (verify
             only, never modifies files). The matching fixer is `spotless:apply`,
             run locally via autofix.sh — it is deliberately NOT bound to a
             lifecycle phase, same as checkstyle:check / pmd:check above, so a
             normal build can never silently rewrite sources.
             GOOGLE style matches google_checks.xml (2-space indent, import
             order) so Spotless and Checkstyle do not undo each other. If you
             swap the Checkstyle config for a custom one, keep the two aligned. -->
        <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <version>${spotless.version}</version>
            <configuration>
                <java>
                    <googleJavaFormat>
                        <version>${google-java-format.version}</version>
                        <style>GOOGLE</style>
                    </googleJavaFormat>
                    <removeUnusedImports/>
                </java>
            </configuration>
        </plugin>

        <!-- ================= UNIT + COVERAGE LAYER ================= -->

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
                <!-- Only picks up plain JUnit5 unit tests by default.
                     Property and regression tests are excluded here and run
                     only inside their own profiles below, so a normal
                     `mvn test` stays fast. -->
                <excludes>
                    <exclude>**/*PropertyTest.java</exclude>
                    <exclude>**/*RegressionTest.java</exclude>
                </excludes>
            </configuration>
        </plugin>

        <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
                <execution>
                    <id>prepare-agent</id>
                    <goals>
                        <goal>prepare-agent</goal>
                    </goals>
                </execution>
                <execution>
                    <id>report</id>
                    <phase>test</phase>
                    <goals>
                        <goal>report</goal>
                    </goals>
                    <configuration>
                        <!-- XML report is what diff-cover reads in CI -->
                        <outputDirectory>target/site/jacoco</outputDirectory>
                    </configuration>
                </execution>
            </executions>
        </plugin>
    </plugins>
</build>

<profiles>
    <!-- ================= AUTOFIX PROFILE (local only, never CI) ================= -->
    <!-- Rewrites source to clear PMD findings that have a safe mechanical fix.
         Run through autofix.sh, which reviews/re-verifies afterwards. This is NOT
         a gate: CI never activates this profile, and a rewrite is not trusted
         until the static + unit + property gates pass on the result.
         Formatting is Spotless's job (above); OpenRewrite only handles the
         semantic cases a formatter cannot touch. Coverage is partial — most PMD
         rules (design, error-prone) have no autofix and still need a human or
         an agent fix, which the gates then verify. -->
    <profile>
        <id>autofix</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.openrewrite.maven</groupId>
                    <artifactId>rewrite-maven-plugin</artifactId>
                    <version>${rewrite-maven-plugin.version}</version>
                    <configuration>
                        <activeRecipes>
                            <!-- PMD UnusedLocalVariable -->
                            <recipe>org.openrewrite.staticanalysis.RemoveUnusedLocalVariables</recipe>
                            <!-- PMD UnusedPrivateField -->
                            <recipe>org.openrewrite.staticanalysis.RemoveUnusedPrivateFields</recipe>
                            <!-- PMD UnusedPrivateMethod -->
                            <recipe>org.openrewrite.staticanalysis.RemoveUnusedPrivateMethods</recipe>
                            <!-- PMD MissingOverride -->
                            <recipe>org.openrewrite.staticanalysis.MissingOverrideAnnotation</recipe>
                            <!-- PMD ClassWithOnlyPrivateConstructorsShouldBeFinal -->
                            <recipe>org.openrewrite.staticanalysis.FinalClass</recipe>
                            <!-- PMD LiteralsFirstInComparisons -->
                            <recipe>org.openrewrite.staticanalysis.EqualsAvoidsNull</recipe>
                        </activeRecipes>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.openrewrite.recipe</groupId>
                            <artifactId>rewrite-static-analysis</artifactId>
                            <version>${rewrite-static-analysis.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </build>
    </profile>

    <!-- ================= PROPERTY / INVARIANT PROFILE ================= -->
    <profile>
        <id>property-tests</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*PropertyTest.java</include>
                        </includes>
                        <excludes>
                            <!-- override the default exclude for this profile only -->
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>

    <!-- ================= REGRESSION / GOLDEN-FILE PROFILE ================= -->
    <profile>
        <id>regression-tests</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*RegressionTest.java</include>
                        </includes>
                        <excludes>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </build>
    </profile>
</profiles>
