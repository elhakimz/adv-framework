# CODEOWNERS — place at repo root (or docs/, .gitlab/ per GitLab's search paths)
#
# Purpose: no matter which agent (Claude Code, Antigravity, Gemini CLI, or a
# human) authors a change, modifications to the files that DEFINE what
# "verified" means always require a human approval before merge. An agent
# can freely modify implementation code; it cannot silently weaken the
# thing that checks the implementation.

# ---- Test suites: an agent should never be able to loosen an assertion,
# delete a test, or add a skip without a human seeing the diff ----
/**/*_test.go               @your-team/leads
/**/*Test.java               @your-team/leads
/**/test_*.py                @your-team/leads
/**/*_test.py                @your-team/leads
/**/*Tests.cs                @your-team/leads
/tests/                      @your-team/leads

# ---- Pipeline / CI definitions: an agent "fixing" a failing pipeline by
# editing the pipeline itself, rather than the underlying bug, is the
# single most dangerous silent failure mode in an agentic workflow ----
/.gitlab-ci.yml               @your-team/leads
/.golangci.yml                @your-team/leads
/checkstyle.xml               @your-team/leads
/pmd-ruleset.xml               @your-team/leads
/pyproject.toml               @your-team/leads
/Directory.Build.props        @your-team/leads

# ---- Golden files / snapshots: an "update" to a verified snapshot is a
# decision that current behavior is now the new correct baseline —
# that's a product decision, not a code-fix, and needs a human sign-off ----
/**/testdata/*.golden         @your-team/leads
/**/__snapshots__/            @your-team/leads
/**/*.verified.txt            @your-team/leads

# ---- Dependency manifests: agents adding a new dependency mid-task is a
# common way security or license risk enters unreviewed ----
/go.mod                       @your-team/leads
/go.sum                       @your-team/leads
/pom.xml                      @your-team/leads
/package.json                 @your-team/leads
/*.csproj                     @your-team/leads

# ---- Security suppression files: an agent "fixing" a failing scan by
# suppressing the finding instead of fixing the vulnerability is the
# security-specific version of weakening a test to make it pass ----
/.trivyignore                 @your-team/leads
/.semgrepignore                @your-team/leads
/.snyk                         @your-team/leads
/bandit.yml                    @your-team/leads
/.gitleaksignore                @your-team/leads
